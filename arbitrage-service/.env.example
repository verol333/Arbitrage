# ─── Serveur ───
PORT=10000
API_SECRET_KEY=changez_moi

# ─── Couche proxy (sélectionne l'implémentation dans src/net/fetcher.js) ───
#   jina        : Jina Reader (par défaut, comme sur Base44)
#   residential : proxy HTTP(S) résidentiel rotatif via fetch natif
#   headless    : rendu Playwright/Puppeteer (nécessite une image avec Chromium)
PROXY_MODE=jina

# Jina
JINA_API_KEY=

# Résidentiel (utilisé quand PROXY_MODE=residential)
# Format URL : http://USER:PASS@host:port  ou  https://USER:PASS@host:port
RESIDENTIAL_PROXY_URL=

# ─── Cache / concurrence de la couche proxy ───
PROXY_CACHE_TTL_MS=75000
PROXY_MAX_CONCURRENCY=3

# ─── Base44 (persistance des opportunités) ───
# Laisser vide pour ne rien écrire — les opportunités restent en mémoire (/opportunities).
BASE44_API_URL=
BASE44_SERVICE_KEY=

# ─── Seuils métier ───
MIN_PROFIT_PREMATCH=0.5
MIN_PROFIT_LIVE=0.5
MAX_MATCHES=400
HORIZON_HOURS=72

# ─── Planification ───
CRON_PREMATCH=*/5 * * * *
LIVE_INTERVAL_MS=15000
